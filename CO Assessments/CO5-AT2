BEGIN
INPUT process_list
FOR each process IN process_list DO
    INPUT process_id
    INPUT arrival_time
    INPUT burst_time
    INPUT priority
    remaining_time = burst_time
END FOR
SET current_time = 0
WHILE there are unfinished processes DO
    ready_queue = SELECT processes
                  WHERE arrival_time <= current_time
                  AND remaining_time > 0
    IF ready_queue is EMPTY THEN
        current_time = current_time + 1
        CONTINUE
    END IF
    SELECT process WITH HIGHEST priority
    FROM ready_queue
    IF two processes have same priority THEN
        SELECT process WITH EARLIER arrival_time
    END IF
    EXECUTE selected process FOR 1 CPU TIME UNIT
    remaining_time = remaining_time - 1
    current_time = current_time + 1
    IF remaining_time == 0 THEN
        MARK process AS COMPLETED
        calculate completion_time
        calculate turnaround_time
        calculate waiting_time
    END IF
END WHILE
CALCULATE:
    Average Waiting Time
    Average Turnaround Time
    CPU Utilization
DISPLAY scheduling order
DISPLAY process completion details
DISPLAY performance metrics
END

