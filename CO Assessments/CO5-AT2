BEGIN
SET threshold = 80%
SET target_usage = 70%
WHILE system is running DO
    usage = GET_DISK_USAGE()
    IF usage > threshold THEN
        DISPLAY "Warning: Disk usage exceeded 80%"
        log_files = FIND_ALL_LOG_FILES()
        SORT log_files BY:
            1. Oldest modification time
            2. Largest size
        FOR each file IN log_files DO
            IF file is currently being written THEN
                ROTATE file
                COMPRESS old file
            ELSE
                COMPRESS file
            ENDIF
            usage = GET_DISK_USAGE()
            IF usage <= target_usage THEN
                BREAK
            ENDIF
        ENDFOR
        IF usage > threshold THEN
            FOR each old compressed log file DO
                DELETE file
                usage = GET_DISK_USAGE()
                IF usage <= target_usage THEN
                    BREAK
                ENDIF
            ENDFOR
        ENDIF
    ELSE
        DISPLAY "Disk usage is normal"
    ENDIF
    WAIT for monitoring interval
END WHILE
END

