BEGIN
INPUT application_list
FOR each app IN application_list DO
    CREATE resource_group(app)
    INPUT cpu_limit
    INPUT memory_limit
    SET CPU_LIMIT(app) = cpu_limit
    SET MEMORY_LIMIT(app) = memory_limit
    ASSIGN app_process TO resource_group(app)
END FOR
WHILE system_is_running DO
    FOR each app IN application_list DO
        cpu_usage = GET_CPU_USAGE(app)
        memory_usage = GET_MEMORY_USAGE(app)
        IF cpu_usage > CPU_LIMIT(app) THEN
            THROTTLE_CPU(app)
            DISPLAY "CPU limit exceeded by", app
        END IF
        IF memory_usage > MEMORY_LIMIT(app) THEN
            IF MEMORY_CAN_BE_RECLAIMED(app) THEN
                RECLAIM_MEMORY(app)
            ELSE
                TERMINATE_OR_RESTRICT(app)
            END IF
            DISPLAY "Memory limit exceeded by", app
        END IF
    END FOR
    WAIT monitoring_interval
END WHILE
END
