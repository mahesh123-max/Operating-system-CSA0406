BEGIN
SET total_RAM = 16 GB
SET host_reserved = 4 GB
SET available_RAM = total_RAM - host_reserved
INPUT number_of_VMs
SET min_RAM = 2 GB
SET allocated_RAM = 0
IF number_of_VMs * min_RAM > available_RAM THEN
    DISPLAY "Insufficient RAM to allocate minimum memory to all VMs"
    EXIT
END IF
FOR i = 1 TO number_of_VMs DO
    VM[i].RAM = min_RAM
    allocated_RAM = allocated_RAM + min_RAM
END FOR
remaining_RAM = available_RAM - allocated_RAM
WHILE remaining_RAM > 0 DO
    FOR i = 1 TO number_of_VMs DO
        IF remaining_RAM <= 0 THEN
            BREAK
        END IF
        memory_demand = GET_MEMORY_DEMAND(VM[i])
        IF memory_demand > VM[i].RAM THEN
            extra_RAM = memory_demand - VM[i].RAM
            IF extra_RAM > remaining_RAM THEN
                extra_RAM = remaining_RAM
            END IF
            VM[i].RAM = VM[i].RAM + extra_RAM
            remaining_RAM = remaining_RAM - extra_RAM
        END IF
    END FOR
END WHILE
FOR i = 1 TO number_of_VMs DO
    DISPLAY "VM", i, "Allocated RAM =", VM[i].RAM
END FOR
DISPLAY "Host Reserved RAM =", host_reserved
DISPLAY "Unused RAM =", remaining_RAM
END

