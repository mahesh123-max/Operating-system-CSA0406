#include <stdio.h>

struct Process {
    int pid, at, bt, ct, wt, tat, done;
};

int main() {
    int n, time = 0, completed = 0, idx;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[n];

    for (int i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("P%d AT BT: ", i + 1);
        scanf("%d%d", &p[i].at, &p[i].bt);
        p[i].done = 0;
    }

    while (completed < n) {
        idx = -1;
        int minBT = 9999;

        for (int i = 0; i < n; i++) {
            if (!p[i].done && p[i].at <= time && p[i].bt < minBT) {
                minBT = p[i].bt;
                idx = i;
            }
        }

        if (idx == -1) {
            time++;
        } else {
            time += p[idx].bt;
            p[idx].ct = time;
            p[idx].tat = p[idx].ct - p[idx].at;
            p[idx].wt = p[idx].tat - p[idx].bt;
            p[idx].done = 1;
            completed++;
        }
    }

    printf("\nPID\tWT\tTAT\n");
    for (int i = 0; i < n; i++)
        printf("P%d\t%d\t%d\n", p[i].pid, p[i].wt, p[i].tat);

    return 0;
}
