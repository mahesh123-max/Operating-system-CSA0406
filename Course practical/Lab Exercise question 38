#include <stdio.h>
#include <stdlib.h>

void sort(int a[], int n)
{
    int i, j, temp;

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
}

int main()
{
    int n, head, disk_size, direction;
    int total = 0, i;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    int request[n];

    printf("Enter disk requests:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &disk_size);

    printf("Enter direction (1 = Right, 0 = Left): ");
    scanf("%d", &direction);

    sort(request, n);

    printf("\nSCAN Service Sequence:\n");
    printf("%d", head);

    if (direction == 1) {
        /* Move towards higher cylinder numbers */
        for (i = 0; i < n; i++) {
            if (request[i] >= head) {
                total += abs(head - request[i]);
                head = request[i];
                printf(" -> %d", head);
            }
        }

        /* Move to the end of the disk */
        total += abs(head - (disk_size - 1));
        head = disk_size - 1;
        printf(" -> %d", head);

        /* Reverse direction */
        for (i = n - 1; i >= 0; i--) {
            if (request[i] < head) {
                total += abs(head - request[i]);
                head = request[i];
                printf(" -> %d", head);
            }
        }
    }
    else {
        /* Move towards lower cylinder numbers */
        for (i = n - 1; i >= 0; i--) {
            if (request[i] <= head) {
                total += abs(head - request[i]);
                head = request[i];
                printf(" -> %d", head);
            }
        }

        /* Move to the beginning of the disk */
        total += abs(head - 0);
        head = 0;
        printf(" -> %d", head);

        /* Reverse direction */
        for (i = 0; i < n; i++) {
            if (request[i] > head) {
                total += abs(head - request[i]);
                head = request[i];
                printf(" -> %d", head);
            }
        }
    }

    printf("\n\nTotal Head Movement = %d cylinders\n", total);

    return 0;
}
