#include <stdio.h>

int main()
{
    int n, record;

    printf("Enter number of records: ");
    scanf("%d", &n);

    int records[n];

    printf("Enter the records:\n");
    for (int i = 0; i < n; i++) {
        printf("Record %d: ", i + 1);
        scanf("%d", &records[i]);
    }

    printf("\nRecords stored sequentially:\n");
    for (int i = 0; i < n; i++) {
        printf("Record %d -> %d\n", i + 1, records[i]);
    }

    printf("\nEnter record number to access: ");
    scanf("%d", &record);

    if (record < 1 || record > n) {
        printf("Invalid record number.\n");
        return 1;
    }

    printf("\nReading records sequentially:\n");

    for (int i = 0; i < record; i++) {
        printf("Reading Record %d -> %d\n", i + 1, records[i]);
    }

    printf("\nRequested Record %d = %d\n",
           record, records[record - 1]);

    return 0;
}
