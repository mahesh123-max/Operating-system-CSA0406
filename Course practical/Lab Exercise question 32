#include <stdio.h>

int main()
{
    int n, frames, pageFaults = 0, time = 0;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    int pages[n];

    printf("Enter page reference string:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    int frame[frames], recent[frames];

    for (int i = 0; i < frames; i++) {
        frame[i] = -1;
        recent[i] = 0;
    }

    printf("\nPage\tFrames\n");

    for (int i = 0; i < n; i++) {
        int found = -1;

        /* Check if page is present */
        for (int j = 0; j < frames; j++) {
            if (frame[j] == pages[i]) {
                found = j;
                break;
            }
        }

        time++;

        if (found != -1) {
            /* Page hit */
            recent[found] = time;
        }
        else {
            /* Page fault */
            pageFaults++;

            int pos = -1;

            /* Find empty frame */
            for (int j = 0; j < frames; j++) {
                if (frame[j] == -1) {
                    pos = j;
                    break;
                }
            }

            /* Find least recently used page */
            if (pos == -1) {
                pos = 0;

                for (int j = 1; j < frames; j++) {
                    if (recent[j] < recent[pos])
                        pos = j;
                }
            }

            frame[pos] = pages[i];
            recent[pos] = time;
        }

        printf("%d\t", pages[i]);

        for (int j = 0; j < frames; j++) {
            if (frame[j] == -1)
                printf("- ");
            else
                printf("%d ", frame[j]);
        }

        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);

    return 0;
}
