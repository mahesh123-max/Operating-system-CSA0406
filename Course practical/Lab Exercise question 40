#include <stdio.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>

void display_permission(mode_t mode)
{
    printf("Permissions: ");

    /* Owner */
    printf((mode & S_IRUSR) ? "r" : "-");
    printf((mode & S_IWUSR) ? "w" : "-");
    printf((mode & S_IXUSR) ? "x" : "-");

    /* Group */
    printf((mode & S_IRGRP) ? "r" : "-");
    printf((mode & S_IWGRP) ? "w" : "-");
    printf((mode & S_IXGRP) ? "x" : "-");

    /* Others */
    printf((mode & S_IROTH) ? "r" : "-");
    printf((mode & S_IWOTH) ? "w" : "-");
    printf((mode & S_IXOTH) ? "x" : "-");

    printf("\n");
}

int main()
{
    int fd;
    struct stat file_info;

    /* Create file */
    fd = open("sample.txt", O_CREAT | O_WRONLY, 0644);

    if (fd < 0) {
        perror("File creation failed");
        return 1;
    }

    close(fd);

    /* Get file information */
    if (stat("sample.txt", &file_info) < 0) {
        perror("stat");
        return 1;
    }

    printf("File: sample.txt\n");

    display_permission(file_info.st_mode);

    printf("\nPermission Types:\n");
    printf("r - Read\n");
    printf("w - Write\n");
    printf("x - Execute\n");

    printf("\nUser Types in Linux:\n");
    printf("1. Owner  - User who owns the file\n");
    printf("2. Group  - Users belonging to the file's group\n");
    printf("3. Others  - All other users\n");

    return 0;
}
