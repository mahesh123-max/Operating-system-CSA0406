#include <stdio.h>
#include <string.h>

#define MAX_USERS 10
#define MAX_FILES 20

struct User {
    char username[30];
    char files[MAX_FILES][50];
    int fileCount;
};

int main()
{
    struct User users[MAX_USERS];
    int userCount = 0;
    int choice, i, j, userIndex, found;
    char username[30], filename[50];

    while (1)
    {
        printf("\n--- Two-Level Directory ---\n");
        printf("1. Create User\n");
        printf("2. Create File\n");
        printf("3. Search File\n");
        printf("4. Display User Files\n");
        printf("5. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                if (userCount >= MAX_USERS)
                {
                    printf("Maximum users reached.\n");
                    break;
                }

                printf("Enter username: ");
                scanf("%s", username);

                found = 0;

                for (i = 0; i < userCount; i++)
                {
                    if (strcmp(users[i].username, username) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if (found)
                {
                    printf("User already exists.\n");
                }
                else
                {
                    strcpy(users[userCount].username, username);
                    users[userCount].fileCount = 0;
                    userCount++;

                    printf("User created successfully.\n");
                }
                break;

            case 2:
                printf("Enter username: ");
                scanf("%s", username);

                userIndex = -1;

                for (i = 0; i < userCount; i++)
                {
                    if (strcmp(users[i].username, username) == 0)
                    {
                        userIndex = i;
                        break;
                    }
                }

                if (userIndex == -1)
                {
                    printf("User not found.\n");
                    break;
                }

                if (users[userIndex].fileCount >= MAX_FILES)
                {
                    printf("Directory is full.\n");
                    break;
                }

                printf("Enter filename: ");
                scanf("%s", filename);

                found = 0;

                for (i = 0; i < users[userIndex].fileCount; i++)
                {
                    if (strcmp(users[userIndex].files[i], filename) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if (found)
                {
                    printf("File already exists.\n");
                }
                else
                {
                    strcpy(users[userIndex].files[
                        users[userIndex].fileCount], filename);

                    users[userIndex].fileCount++;

                    printf("File created successfully.\n");
                }
                break;

            case 3:
                printf("Enter username: ");
                scanf("%s", username);

                userIndex = -1;

                for (i = 0; i < userCount; i++)
                {
                    if (strcmp(users[i].username, username) == 0)
                    {
                        userIndex = i;
                        break;
                    }
                }

                if (userIndex == -1)
                {
                    printf("User not found.\n");
                    break;
                }

                printf("Enter filename to search: ");
                scanf("%s", filename);

                found = 0;

                for (i = 0; i < users[userIndex].fileCount; i++)
                {
                    if (strcmp(users[userIndex].files[i], filename) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if (found)
                    printf("File found in %s directory.\n", username);
                else
                    printf("File not found.\n");

                break;

            case 4:
                printf("Enter username: ");
                scanf("%s", username);

                userIndex = -1;

                for (i = 0; i < userCount; i++)
                {
                    if (strcmp(users[i].username, username) == 0)
                    {
                        userIndex = i;
                        break;
                    }
                }

                if (userIndex == -1)
                {
                    printf("User not found.\n");
                    break;
                }

                printf("\nFiles of user %s:\n", username);

                if (users[userIndex].fileCount == 0)
                {
                    printf("No files.\n");
                }
                else
                {
                    for (j = 0; j < users[userIndex].fileCount; j++)
                        printf("%d. %s\n", j + 1,
                               users[userIndex].files[j]);
                }

                break;

            case 5:
                return 0;

            default:
                printf("Invalid choice.\n");
        }
    }

    return 0;
}
