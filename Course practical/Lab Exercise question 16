#include <stdio.h>
#include <stdlib.h>

struct Employee {
    int id;
    char name[30];
    float salary;
};

int main()
{
    FILE *fp;
    struct Employee emp;
    int n, id;

    fp = fopen("employee.dat", "wb+");

    if (fp == NULL) {
        printf("Unable to open file.\n");
        return 1;
    }

    printf("Enter number of employees: ");
    scanf("%d", &n);

    printf("\nEnter employee details:\n");

    for (int i = 0; i < n; i++) {
        printf("\nEmployee %d\n", i + 1);

        printf("ID: ");
        scanf("%d", &emp.id);

        printf("Name: ");
        scanf("%s", emp.name);

        printf("Salary: ");
        scanf("%f", &emp.salary);

        fwrite(&emp, sizeof(emp), 1, fp);
    }

    printf("\nEnter employee ID to access: ");
    scanf("%d", &id);

    /* Move directly to the required record */
    fseek(fp, (id - 1) * sizeof(struct Employee), SEEK_SET);

    if (fread(&emp, sizeof(emp), 1, fp) == 1 &&
        emp.id == id) {

        printf("\nEmployee Details:\n");
        printf("ID     : %d\n", emp.id);
        printf("Name   : %s\n", emp.name);
        printf("Salary : %.2f\n", emp.salary);
    }
    else {
        printf("Employee not found.\n");
    }

    fclose(fp);

    return 0;
}
