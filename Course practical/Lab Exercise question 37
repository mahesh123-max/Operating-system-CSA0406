#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, head, total = 0;

    printf("Enter number of disk requests: ");
    scanf("%d", &n);

    int request[n];

    printf("Enter disk requests:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nFCFS Service Sequence:\n");
    printf("%d", head);

    for (int i = 0; i < n; i++) {
        total += abs(head - request[i]);
        head = request[i];

        printf(" -> %d", request[i]);
    }

    printf("\n\nTotal Head Movement = %d cylinders\n", total);

    return 0;
}
