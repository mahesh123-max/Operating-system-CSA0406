#include <stdio.h>
#include <stdlib.h>

void sort(int a[], int n)
{
    int i, j, temp;

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
}

int main()
{
    int n, head, disk_size;
    int total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    int request[n];

    printf("Enter disk requests:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &disk_size);

    sort(request, n);

    printf("\nC-SCAN Service Sequence:\n");
    printf("%d", head);

    /* Move towards higher cylinder numbers */
    for (int i = 0; i < n; i++) {
        if (request[i] >= head) {
            total += abs(head - request[i]);
            head = request[i];
            printf(" -> %d", head);
        }
    }

    /* Move to end of disk */
    total += abs(head - (disk_size - 1));
    head = disk_size - 1;
    printf(" -> %d", head);

    /* Jump to beginning */
    total += disk_size - 1;
    head = 0;
    printf(" -> %d", head);

    /* Continue in the same direction */
    for (int i = 0; i < n; i++) {
        if (request[i] < head)
            continue;

        if (request[i] < disk_size) {
            total += abs(head - request[i]);
            head = request[i];
            printf(" -> %d", head);
        }
    }

    printf("\n\nTotal Head Movement = %d cylinders\n", total);

    return 0;
}
